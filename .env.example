# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Use the Neon pooler URL (port 6543) for DATABASE_URL
# and the direct URL (port 5432) for DIRECT_URL (required for Prisma migrations)
DATABASE_URL="postgresql://username:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth SSO (Google + Microsoft) — CURRENTLY DISABLED ─────────────────────
# Google and Microsoft (Azure AD) OAuth login is disabled by default. The
# providers are not registered with NextAuth unless ENABLE_OAUTH_SSO="true",
# the login page hides the buttons, and direct hits on the callback URLs 404.
# Credentials login (email + password) and SAML SSO are unaffected.
#
# To re-enable in the future:
#   1. Set ENABLE_OAUTH_SSO="true" on Vercel.
#   2. Configure the OAuth client credentials below.
#   3. Re-add the redirect URIs in Google Cloud Console and Azure Portal:
#      - https://asd-training-app-v2.vercel.app/api/auth/callback/google
#      - https://asd-training-app-v2.vercel.app/api/auth/callback/azure-ad
ENABLE_OAUTH_SSO="false"

# Google OAuth — only used when ENABLE_OAUTH_SSO="true".
# Create at https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft Azure AD — only used when ENABLE_OAUTH_SSO="true".
# Create at https://portal.azure.com → Azure Active Directory → App registrations
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
# signInAudience: AzureADandPersonalMicrosoftAccount (for personal + work accounts)
AZURE_AD_CLIENT_ID="your-azure-app-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-client-secret"
AZURE_AD_TENANT_ID="common"

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Used for forgot-password emails. Get a free key at https://resend.com
RESEND_API_KEY="your-resend-api-key"

# Optional. Override the logo URL embedded at the top of every transactional
# email. If unset, the resolver falls through to NEXTAUTH_URL →
# VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL and serves /logo-aaa.png from
# whichever is reachable. Set this if you host the logo on a separate CDN or
# want emails to use a different brand asset than the app's public URL.
# EMAIL_LOGO_URL="https://cdn.example.com/aaa-logo.png"

# ─── Vercel Blob (Document Library file storage) ─────────────────────────────
# Auto-provisioned on Vercel if you add the Blob store via dashboard
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"

# ─── Stripe Payments ──────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys (test mode until charity account is live)
# Webhook secret comes from either the Stripe CLI (`stripe listen`) or the
# dashboard webhook endpoint config once deployed.
# Subscription price ID is created in the Stripe dashboard under Products →
# "All-Access" with a yearly recurring price.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUBSCRIPTION_PRICE_YEARLY="price_..."

# Feature flag. Set to "true" on dev only while building. Flip on in production
# ONLY after the charity's live Stripe account is configured.
ENABLE_PAYMENTS="false"
