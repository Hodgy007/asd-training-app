# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Use the Neon pooler URL (port 6543) for DATABASE_URL
# and the direct URL (port 5432) for DIRECT_URL (required for Prisma migrations)
DATABASE_URL="postgresql://username:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth SSO (Google + Microsoft) ──────────────────────────────────────────
# The old ENABLE_OAUTH_SSO env flag is GONE. Providers register with NextAuth
# whenever their credentials below are present, but logins are only accepted
# once a super admin turns the provider on at /super-admin/settings/sso
# (DB-backed OAuthSsoConfig). Both default off. Credentials login and SAML SSO
# are unaffected. Redirect URIs to register with each provider:
#   - https://asd-training-app-v2.vercel.app/api/auth/callback/google
#   - https://asd-training-app-v2.vercel.app/api/auth/callback/azure-ad

# Google OAuth. Create at https://console.cloud.google.com → Credentials.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft Azure AD. Create at https://portal.azure.com → App registrations.
# Pin AZURE_AD_TENANT_ID to your tenant rather than "common" unless you
# intend to accept personal + any-work Microsoft accounts (see the September
# 2026 security review, finding M1).
AZURE_AD_CLIENT_ID="your-azure-app-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-client-secret"
AZURE_AD_TENANT_ID="common"

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Used for forgot-password emails. Get a free key at https://resend.com
RESEND_API_KEY="your-resend-api-key"

# Optional. Override the logo URL embedded at the top of every transactional
# email. If unset, the resolver falls through to NEXTAUTH_URL →
# VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL and serves /logo-aaa.png from
# whichever is reachable. Set this if you host the logo on a separate CDN or
# want emails to use a different brand asset than the app's public URL.
# EMAIL_LOGO_URL="https://cdn.example.com/aaa-logo.png"

# ─── Vercel Blob (Document Library file storage) ─────────────────────────────
# Auto-provisioned on Vercel if you add the Blob store via dashboard
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"

# ─── Stripe Payments ──────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys (test mode until charity account is live)
# Webhook secret comes from either the Stripe CLI (`stripe listen`) or the
# dashboard webhook endpoint config once deployed.
# Subscription price ID is created in the Stripe dashboard under Products →
# "All-Access" with a yearly recurring price.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUBSCRIPTION_PRICE_YEARLY="price_..."

# Feature flag. Set to "true" on dev only while building. Flip on in production
# ONLY after the charity's live Stripe account is configured.
ENABLE_PAYMENTS="false"

# ─── Eventbrite Integration ──────────────────────────────────────────────────
# The Eventbrite Private Token is NOT stored as an env var — it lives in the
# database (CharityEventbriteConfig) and is set/rotated via the UI at:
#   /super-admin/settings/eventbrite
# Get the token from Eventbrite → Account Settings → Developer Links → API Keys.
# When configured, the webhook receiver at /api/webhooks/eventbrite auto-syncs
# bookings into cohort memberships, and /api/cron/eventbrite-sync acts as the
# nightly backstop.

# ─── Cron secret (optional) ──────────────────────────────────────────────────
# Bearer token guarding /api/cron/* routes. REQUIRED wherever cron runs: the
# routes are fail-closed (500 when unset, 401 unless the request carries
# `Authorization: Bearer <CRON_SECRET>`). Vercel injects this header on
# scheduled runs when the env var is set. The old `x-vercel-cron` fallback
# was removed — that header is attacker-settable and is not a credential.
# CRON_SECRET="generate-with: openssl rand -hex 32"
