generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  password           String?
  role               Role     @default(CAREGIVER)
  active             Boolean  @default(true)
  pendingApproval    Boolean  @default(false)
  organisationId     String?
  mustChangePassword Boolean  @default(false)
  totpSecret         String?
  totpEnabled        Boolean  @default(false)
  charityPermissions String[] @default([])
  notificationsLastOpenedAt DateTime?
  invitedAt          DateTime?
  invitedBy          String?
  stripeCustomerId             String?            @unique
  stripeSubscriptionId         String?
  subscriptionStatus           SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionPriceId          String?
  allowedProgramIds            String[]           @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation       Organisation?          @relation(fields: [organisationId], references: [id])
  accounts           Account[]
  sessions           Session[]
  trainingProgress   TrainingProgress[]
  announcements      Announcement[]         @relation("AnnouncementsCreated")
  hostedSessions     ClassSession[]         @relation("SessionHost")
  createdSessions    ClassSession[]         @relation("SessionCreator")
  sessionAttendees   SessionAttendee[]
  surveysCreated     Survey[]               @relation("SurveysCreated")
  surveyResponses    SurveyResponse[]       @relation("SurveyResponses")
  collectionsCreated LibraryCollection[]    @relation("CollectionsCreated")
  uploadedDocuments  LibraryDocument[]      @relation("UploadedDocuments")
  documentEvents     LibraryDocumentEvent[] @relation("DocumentEvents")
  integrationKeys    IntegrationApiKey[]    @relation("IntegrationKeys")
  cvs                    CV[]
  careerAdvisorSessions  CareerAdvisorSession[]
  lessonNotes            LessonNote[]
  invitedByUser      User?                  @relation("UserInviter", fields: [invitedBy], references: [id])
  invitedUsers       User[]                 @relation("UserInviter")
  editedAiPrompts    AiPrompt[]             @relation("AiPromptEditor")
  jobsCreated          JobOpening[]    @relation("JobOpeningCreatedBy")
  jobAssignments       JobAssignment[] @relation("JobAssignmentUser")
  jobAssignmentsGiven  JobAssignment[] @relation("JobAssignmentAssignedBy")
  feedbackSubmissions FeedbackSubmission[] @relation("FeedbackSubmitter")
  resolvedFeedback    FeedbackSubmission[] @relation("FeedbackResolver")
  purchases            Purchase[]

  @@index([organisationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organisation {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  active            Boolean          @default(true)
  organisationType  OrganisationType @default(BUSINESS)
  allowedProgramIds String[]
  allowedRoles      String[]
  cvBuilderEnabled      Boolean  @default(true)
  careersAdvisorEnabled Boolean  @default(true)
  logoUrl               String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  county            String?
  postcode          String?
  country           String   @default("United Kingdom")
  pendingApproval   Boolean  @default(false)
  orgType           OrgType  @default(ORGANISATION)
  parentOrgId       String?
  isParentOrg       Boolean  @default(false)
  inheritSettings   Boolean  @default(true)
  isPersonal                   Boolean            @default(false)
  stripeCustomerId             String?            @unique
  stripeSubscriptionId         String?
  subscriptionStatus           SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionPriceId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parentOrg     Organisation?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  childOrgs     Organisation[] @relation("OrgHierarchy")
  users         User[]
  announcements Announcement[]
  sessions      ClassSession[]
  meetingConfig OrgMeetingConfig?
  ssoConfig     OrgSsoConfig?
  surveyTargets SurveyTarget[]
  feedback      FeedbackSubmission[] @relation("OrgFeedback")
  purchases     Purchase[]

  @@index([parentOrgId])
}

model Announcement {
  id             String    @id @default(cuid())
  title          String
  body           String
  active         Boolean   @default(true)
  organisationId String?
  createdById    String
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("AnnouncementsCreated", fields: [createdById], references: [id])

  @@index([organisationId])
}

model TrainingProgress {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  lessonId    String?
  completed   Boolean   @default(false)
  score           Int?
  interactionData Json?
  completedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

enum LessonType {
  TEXT
  VIDEO
  SCORM
  SURVEY
}

model LibraryCollection {
  id                 String   @id @default(cuid())
  title              String
  description        String   @db.Text
  thumbnailUrl       String?
  targetOrgIds       String[]
  targetRoles        String[]
  active             Boolean  @default(true)
  publishedToToolkit Boolean  @default(false)
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User              @relation("CollectionsCreated", fields: [createdById], references: [id])
  documents LibraryDocument[]
}

model LibraryDocument {
  id           String   @id @default(cuid())
  collectionId String
  title        String
  description  String   @db.Text
  fileUrl      String
  fileName     String
  fileSize     Int
  fileType     String
  thumbnailUrl String?
  active       Boolean  @default(true)
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection LibraryCollection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  uploadedBy User                   @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  events     LibraryDocumentEvent[]
}

model LibraryDocumentEvent {
  id             String   @id @default(cuid())
  documentId     String
  userId         String
  organisationId String?
  action         String
  createdAt      DateTime @default(now())

  document LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation("DocumentEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, action])
  @@index([organisationId])
}

enum ProgramStatus { DRAFT UNDER_REVIEW APPROVED ARCHIVED }
enum ProgramAudience { EDUCATION EMPLOYER }
enum OrganisationType { SCHOOL COLLEGE ACADEMY UNIVERSITY EMPLOYER EDUCATION BUSINESS }
enum Role { SUPER_ADMIN CHARITY_EMPLOYEE ORG_ADMIN CAREGIVER CAREER_DEV_OFFICER STUDENT INTERN EMPLOYEE }
enum SurveyStatus { DRAFT PUBLISHED CLOSED }
enum JobStatus { DRAFT PUBLISHED CLOSED ARCHIVED }
enum JobLocationType { ONSITE HYBRID REMOTE }
enum JobEmploymentType { INTERNSHIP APPRENTICESHIP PART_TIME FULL_TIME VOLUNTEER }
enum QuestionType { MULTIPLE_CHOICE YES_NO FREE_TEXT RATING_SCALE MULTI_SELECT }
enum InsightType { SUMMARY COMPARATIVE RECOMMENDATIONS }
enum CVTemplate { CLASSIC MODERN ACCESSIBLE }
enum CVStatus { DRAFT COMPLETE }
enum MeetingPlatform { ZOOM TEAMS CUSTOM IN_PERSON }
enum OrgType { ORGANISATION COHORT PERSONAL }
enum SessionStatus { SCHEDULED IN_PROGRESS COMPLETED CANCELLED }
enum SubscriptionStatus { NONE ACTIVE TRIALING PAST_DUE CANCELED UNPAID }
enum FeedbackType { BUG SUGGESTION QUESTION OTHER }
enum FeedbackStatus { NEW IN_PROGRESS RESOLVED }
enum PurchaseStatus { PENDING PAID REFUNDED FAILED }
