generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String             @id @default(cuid())
  email                        String             @unique
  name                         String?
  password                     String?
  role                         Role               @default(CAREGIVER)
  active                       Boolean            @default(true)
  pendingApproval              Boolean            @default(false)
  organisationId               String?
  mustChangePassword           Boolean            @default(false)
  totpSecret                   String?
  totpEnabled                  Boolean            @default(false)
  charityPermissions           String[]           @default([])
  notificationsLastOpenedAt    DateTime?
  invitedAt                    DateTime?
  invitedBy                    String?
  // Individual-subscriber fields. Only used when organisationId is null —
  // i.e. the user purchased on their own and isn't part of a shared org.
  // Resolved alongside org-level fields by lib/subscription.ts.
  stripeCustomerId             String?            @unique
  stripeSubscriptionId         String?
  subscriptionStatus           SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionPriceId          String?
  // Timestamp of the most-recently applied Stripe subscription event for this
  // owner. Used to drop stale `customer.subscription.*` events that arrive
  // out of order (e.g. a late `updated` after `deleted`).
  lastStripeEventAt            DateTime?
  allowedProgramIds            String[]           @default([])
  // Per-user feature overrides (mainly for Independent Learners). Null means
  // "inherit from the user's org"; explicit true/false overrides the org flag.
  cvBuilderEnabled             Boolean?
  careersAdvisorEnabled        Boolean?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  organisation          Organisation?          @relation(fields: [organisationId], references: [id])
  accounts              Account[]
  sessions              Session[]
  trainingProgress      TrainingProgress[]
  announcements         Announcement[]         @relation("AnnouncementsCreated")
  hostedSessions        ClassSession[]         @relation("SessionHost")
  createdSessions       ClassSession[]         @relation("SessionCreator")
  sessionAttendees      SessionAttendee[]
  surveysCreated        Survey[]               @relation("SurveysCreated")
  surveyResponses       SurveyResponse[]       @relation("SurveyResponses")
  collectionsCreated    LibraryCollection[]    @relation("CollectionsCreated")
  uploadedDocuments     LibraryDocument[]      @relation("UploadedDocuments")
  documentEvents        LibraryDocumentEvent[] @relation("DocumentEvents")
  integrationKeys       IntegrationApiKey[]    @relation("IntegrationKeys")
  cvs                   CV[]
  surveyTargets         SurveyTarget[]         @relation("SurveyTargets")
  careerAdvisorSessions CareerAdvisorSession[]
  lessonNotes           LessonNote[]
  cohortMemberships     CohortMembership[]
  invitedByUser         User?                  @relation("UserInviter", fields: [invitedBy], references: [id])
  invitedUsers          User[]                 @relation("UserInviter")
  editedAiPrompts       AiPrompt[]             @relation("AiPromptEditor")
  jobsCreated           JobOpening[]           @relation("JobOpeningCreatedBy")
  jobAssignments        JobAssignment[]        @relation("JobAssignmentUser")
  jobAssignmentsGiven   JobAssignment[]        @relation("JobAssignmentAssignedBy")
  feedbackSubmissions   FeedbackSubmission[]   @relation("FeedbackSubmitter")
  resolvedFeedback      FeedbackSubmission[]   @relation("FeedbackResolver")
  purchases             Purchase[]
  toolkitRegistrant     ToolkitRegistrant?     @relation("ToolkitRegistrantUser")
  brandAssetsUploaded   BrandAsset[]           @relation("BrandAssetsUploaded")

  @@index([organisationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organisation {
  id                           String             @id @default(cuid())
  name                         String
  slug                         String             @unique
  active                       Boolean            @default(true)
  organisationType             OrganisationType   @default(BUSINESS)
  allowedProgramIds            String[]
  allowedRoles                 String[]
  cvBuilderEnabled             Boolean            @default(true)
  careersAdvisorEnabled        Boolean            @default(true)
  logoUrl                      String?
  contactName                  String?
  contactEmail                 String?
  contactPhone                 String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  county                       String?
  postcode                     String?
  country                      String             @default("United Kingdom")
  pendingApproval              Boolean            @default(false)
  orgType                      OrgType            @default(ORGANISATION)
  parentOrgId                  String?
  isParentOrg                  Boolean            @default(false)
  inheritSettings              Boolean            @default(true)
  isPersonal                   Boolean            @default(false)
  lifecycleStatus              OrgLifecycleStatus @default(ACTIVE)
  archivedAt                   DateTime?
  inviteCode                   String?            @unique
  inviteEnabled                Boolean            @default(false)
  inviteExpiresAt              DateTime?
  stripeCustomerId             String?            @unique
  stripeSubscriptionId         String?
  subscriptionStatus           SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionPriceId          String?
  // See User.lastStripeEventAt — drops stale subscription events.
  lastStripeEventAt            DateTime?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  parentOrg         Organisation?        @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  childOrgs         Organisation[]       @relation("OrgHierarchy")
  users             User[]
  cohortMemberships CohortMembership[]
  announcements     Announcement[]
  sessions          ClassSession[]
  meetingConfig     OrgMeetingConfig?
  ssoConfig         OrgSsoConfig?
  surveyTargets     SurveyTarget[]
  feedback          FeedbackSubmission[] @relation("OrgFeedback")
  purchases         Purchase[]

  @@index([parentOrgId])
  @@index([orgType, lifecycleStatus])
}

model CohortMembership {
  id        String                 @id @default(cuid())
  userId    String
  cohortId  String
  status    CohortMembershipStatus @default(ACTIVE)
  joinedAt  DateTime               @default(now())
  leftAt    DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Organisation @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([status])
}

model Announcement {
  id             String    @id @default(cuid())
  title          String
  body           String
  active         Boolean   @default(true)
  organisationId String?
  createdById    String
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("AnnouncementsCreated", fields: [createdById], references: [id])

  @@index([organisationId])
}

model TrainingProgress {
  id              String    @id @default(cuid())
  userId          String
  moduleId        String
  lessonId        String?
  completed       Boolean   @default(false)
  score           Int?
  interactionData Json?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  purpose   String   @default("RESET")
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

enum LessonType {
  TEXT
  VIDEO
  SCORM
  SURVEY
}

model Module {
  id               String          @id
  title            String
  description      String
  order            Int
  active           Boolean         @default(true)
  gatsbyBenchmarks String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  programId        String
  program          TrainingProgram @relation(fields: [programId], references: [id])
  lessons          Lesson[]
}

model Lesson {
  id                String             @id
  moduleId          String
  title             String
  type              LessonType
  content           String             @db.Text
  interactiveBlocks Json?
  videoUrl          String?
  transcript        String?            @db.Text
  order             Int
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  scormBlobPrefix   String?
  scormEntryPath    String?
  scormVersion      String?
  scormToc          Json?
  surveyId          String?
  module            Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  survey            Survey?            @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  quizQuestions     QuizQuestion[]
  attachments       LessonAttachment[]
  notes             LessonNote[]

  @@index([surveyId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  lessonId      String
  question      String   @db.Text
  options       String   @db.Text
  correctAnswer String
  explanation   String   @db.Text
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  fileName  String
  fileSize  Int
  url       String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model TrainingProgram {
  id              String          @id @default(cuid())
  name            String
  description     String?         @db.Text
  order           Int
  active          Boolean         @default(true)
  version         String          @default("1.0")
  status          ProgramStatus   @default(DRAFT)
  audience        ProgramAudience @default(EDUCATION)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?         @db.Text
  priceAmount     Int?
  currency        String          @default("gbp")
  stripeProductId String?
  stripePriceId   String?
  purchasable     Boolean         @default(false)
  // Default role assigned to users who self-provision themselves into this
  // program — currently the free-claim flow on /courses and the anonymous
  // Stripe checkout webhook. Admin-created users are unaffected.
  // Should always be a leaf role (CAREGIVER / CAREER_DEV_OFFICER / STUDENT
  // / INTERN / EMPLOYEE); the admin form enforces that.
  defaultLeafRole Role?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  modules   Module[]
  purchases Purchase[]
}

model ClassSession {
  id               String          @id @default(cuid())
  title            String
  description      String?         @db.Text
  scheduledAt      DateTime
  duration         Int
  meetingUrl       String?
  recordingUrl     String?
  platform         MeetingPlatform @default(CUSTOM)
  status           SessionStatus   @default(SCHEDULED)
  hostId           String
  createdById      String
  organisationId   String?
  isCharitySession Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  host         User              @relation("SessionHost", fields: [hostId], references: [id])
  createdBy    User              @relation("SessionCreator", fields: [createdById], references: [id])
  organisation Organisation?     @relation(fields: [organisationId], references: [id])
  attendees    SessionAttendee[]

  @@index([scheduledAt])
}

model SessionAttendee {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  attended  Boolean   @default(false)
  joinedAt  DateTime?

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model OrgMeetingConfig {
  id             String          @id @default(cuid())
  organisationId String          @unique
  platform       MeetingPlatform
  apiKey         String?
  apiSecret      String?
  tenantId       String?
  configured     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

model CharityMeetingConfig {
  id         String          @id @default(cuid())
  platform   MeetingPlatform @default(CUSTOM)
  apiKey     String?
  apiSecret  String?
  tenantId   String?
  configured Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model OrgSsoConfig {
  id             String   @id @default(cuid())
  organisationId String   @unique
  emailDomain    String   @unique
  metadataUrl    String?
  ssoUrl         String
  entityId       String
  certificate    String   @db.Text
  autoProvision  Boolean  @default(false)
  defaultRole    String?
  configured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

model CharitySsoConfig {
  id                     String   @id @default(cuid())
  displayName            String   @default("Charity")
  provider               String   @default("saml")
  entityId               String?
  ssoUrl                 String?
  certificate            String?  @db.Text
  enforceForCharityUsers Boolean  @default(false)
  configured             Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Server-side nonce store for SAML AuthnRequest IDs. The IdP echoes our
// request ID back as InResponseTo on the SAML Response; we mark the row
// `consumed` on first use to prevent replay. Rows expire after 1 hour.
model SamlAuthnRequest {
  id        String   @id
  email     String
  isCharity Boolean  @default(false)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Survey {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      SurveyStatus @default(DRAFT)
  closesAt    DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User             @relation("SurveysCreated", fields: [createdById], references: [id])
  questions SurveyQuestion[]
  targets   SurveyTarget[]
  responses SurveyResponse[]
  insights  SurveyInsight[]
  lessons   Lesson[]
}

model SurveyQuestion {
  id       String       @id @default(cuid())
  surveyId String
  type     QuestionType
  question String       @db.Text
  options  String?      @db.Text
  required Boolean      @default(true)
  order    Int

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]
}

model SurveyTarget {
  id             String  @id @default(cuid())
  surveyId       String
  // Targeting modes (any one or combination): role, organisation, individual user.
  // Independent Learners users are assigned surveys via userId (per-user picks)
  // because the org has no shared baseline; normal-org users still get surveys
  // via role/organisationId targeting.
  role           Role?
  organisationId String?
  userId         String?

  survey       Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  user         User?         @relation("SurveyTargets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SurveyResponse {
  id          String    @id @default(cuid())
  surveyId    String
  userId      String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user    User           @relation("SurveyResponses", fields: [userId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([surveyId, userId])
  @@index([userId])
}

model SurveyAnswer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  value      String @db.Text

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model SurveyInsight {
  id          String      @id @default(cuid())
  surveyId    String
  type        InsightType
  content     String      @db.Text
  generatedAt DateTime    @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, type])
}

enum MeetingPlatform {
  ZOOM
  TEAMS
  CUSTOM
  IN_PERSON
}

enum OrgType {
  ORGANISATION
  COHORT
  PERSONAL
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProgramStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ARCHIVED
}

enum ProgramAudience {
  EDUCATION
  EMPLOYER
}

enum OrganisationType {
  SCHOOL
  COLLEGE
  ACADEMY
  UNIVERSITY
  EMPLOYER
  EDUCATION // legacy — kept for existing rows
  BUSINESS // legacy — kept for existing rows
}

enum Role {
  SUPER_ADMIN
  CHARITY_EMPLOYEE
  ORG_ADMIN
  CAREGIVER
  CAREER_DEV_OFFICER
  STUDENT
  INTERN
  EMPLOYEE
  PARTICIPANT
  FAMILY_CARER
}

enum OrgLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum CohortMembershipStatus {
  ACTIVE
  LEFT
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobLocationType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobEmploymentType {
  INTERNSHIP
  APPRENTICESHIP
  PART_TIME
  FULL_TIME
  VOLUNTEER
}

enum QuestionType {
  MULTIPLE_CHOICE
  YES_NO
  FREE_TEXT
  RATING_SCALE
  MULTI_SELECT
}

enum InsightType {
  SUMMARY
  COMPARATIVE
  RECOMMENDATIONS
}

enum CVTemplate {
  CLASSIC
  MODERN
  ACCESSIBLE
}

enum CVStatus {
  DRAFT
  COMPLETE
}

model LibraryCollection {
  id                 String   @id @default(cuid())
  title              String
  description        String   @db.Text
  thumbnailUrl       String?
  // Visual theme on the learner-facing library tile. Null = auto-cycle from
  // the palette by collection id. Set to one of the palette keys (orange,
  // green, blue, pink, yellow, cyan) to lock the colour.
  themeKey           String?
  targetOrgIds       String[]
  targetRoles        String[]
  active             Boolean  @default(true)
  publishedToToolkit Boolean  @default(false)
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User              @relation("CollectionsCreated", fields: [createdById], references: [id])
  documents LibraryDocument[]
  sections  LibrarySection[]
}

// Optional grouping inside a LibraryCollection. When zero sections exist the
// collection's documents render as a flat grid (back-compat). When sections
// exist the read-only views group documents by section, ordered by
// LibrarySection.order then LibraryDocument.order. Documents whose
// sectionId is null fall through to a final "Other resources" group.
model LibrarySection {
  id           String   @id @default(cuid())
  collectionId String
  title        String
  description  String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  documents  LibraryDocument[]

  @@index([collectionId, order])
}

model LibraryDocument {
  id           String   @id @default(cuid())
  collectionId String
  // Optional grouping inside the parent collection. Null = unsectioned
  // (rendered under an "Other resources" heading once any sections exist).
  sectionId    String?
  // Position within the section (or within the unsectioned bucket).
  // Sequential ints, mutated directly by PATCH like Module.order /
  // Lesson.order — no swap helper / fractional indexing.
  order        Int      @default(0)
  title        String
  description  String   @db.Text
  fileUrl      String
  fileName     String
  fileSize     Int
  fileType     String
  thumbnailUrl String?
  videoUrl     String?
  active       Boolean  @default(true)
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection        LibraryCollection               @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  section           LibrarySection?                 @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  uploadedBy        User                            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  events            LibraryDocumentEvent[]
  anonymousEvents   ToolkitAnonymousDocumentEvent[]
  toolkitDownloads  ToolkitDownload[]               @relation("ToolkitDownloads")

  @@index([collectionId, sectionId, order])
}

model LibraryDocumentEvent {
  id             String   @id @default(cuid())
  documentId     String
  userId         String
  organisationId String?
  action         String // "view" or "download"
  createdAt      DateTime @default(now())

  document LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User            @relation("DocumentEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, action])
  @@index([organisationId])
  @@index([createdAt])
}

model ToolkitAnonymousDocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  action     String
  createdAt  DateTime @default(now())

  document LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, action])
  @@index([createdAt])
}

// Charity-owned brand asset store. Distinct from LibraryCollection (which
// is consumer-facing). These rows are admin-only — logos, brand
// guidelines, sample imagery, palette references, copy/tone-of-voice docs
// — and feed two integration points:
//   1. AI generators that opt in to "use brand store as context" prepend
//      text-y assets to the prompt and pass image URLs as style refs.
//   2. Image upload fields offer "pick from brand store" as an alternative
//      to file upload, so admins can reuse the canonical logo/imagery.
model BrandAsset {
  id           String         @id @default(cuid())
  type         BrandAssetType @default(OTHER)
  title        String
  description  String?        @db.Text
  fileUrl      String
  fileName     String
  fileSize     Int
  fileType     String
  // Active=false hides it from the picker / AI context but keeps the row
  // (and the Blob) so historical references stay resolvable.
  active       Boolean        @default(true)
  uploadedById String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  uploadedBy User @relation("BrandAssetsUploaded", fields: [uploadedById], references: [id])

  @@index([type, active])
  @@index([createdAt])
}

enum BrandAssetType {
  LOGO
  BRAND_GUIDELINES
  IMAGERY
  COLOUR_PALETTE
  MESSAGING
  OTHER
}

// Lead-capture record for the public /toolkit download flow. One row per
// unique email. `userId` is set if the visitor opted to also create a real
// platform account from the form (which lives in the Public Toolkit Users
// org). Without `userId` they're a lead-only — we know who they are but
// they have no platform sign-in.
model ToolkitRegistrant {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  formRole         String
  organisation     String?
  postcode         String?
  marketingConsent Boolean           @default(false)
  userId           String?           @unique
  createdAt        DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())

  user      User?             @relation("ToolkitRegistrantUser", fields: [userId], references: [id], onDelete: SetNull)
  downloads ToolkitDownload[]

  @@index([email])
}

model ToolkitDownload {
  id           String   @id @default(cuid())
  registrantId String
  documentId   String
  createdAt    DateTime @default(now())

  registrant ToolkitRegistrant @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  document   LibraryDocument   @relation("ToolkitDownloads", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([registrantId])
  @@index([createdAt])
}

model IntegrationApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String // first 8 chars for display (e.g. "int_abc1...")
  createdById String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  createdBy User @relation("IntegrationKeys", fields: [createdById], references: [id])
}

model CV {
  id                     String     @id @default(cuid())
  userId                 String
  title                  String     @default("My CV")
  template               CVTemplate @default(ACCESSIBLE)
  status                 CVStatus   @default(DRAFT)
  currentStep            Int        @default(0)
  fullName               String?
  email                  String?
  phone                  String?
  city                   String?
  postcode               String?
  linkedIn               String?
  personalStatement      String?    @db.Text
  interests              String?    @db.Text
  refsAvailableOnRequest Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences  CVWorkExperience[]
  educationEntries CVEducation[]
  skills           CVSkill[]
  references       CVReference[]

  @@index([userId])
}

model CVWorkExperience {
  id          String   @id @default(cuid())
  cvId        String
  jobTitle    String
  employer    String
  startDate   String
  endDate     String?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVEducation {
  id            String   @id @default(cuid())
  cvId          String
  institution   String
  qualification String
  grade         String?
  startDate     String
  endDate       String?
  description   String?  @db.Text
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVSkill {
  id       String  @id @default(cuid())
  cvId     String
  name     String
  category String?
  order    Int     @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model CVReference {
  id           String  @id @default(cuid())
  cvId         String
  name         String
  jobTitle     String?
  organisation String?
  email        String?
  phone        String?
  relationship String?
  order        Int     @default(0)

  cv CV @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

// ─── Careers Advisor ─────────────────────────────────────────────────────────

enum AdvisorSessionStatus {
  IN_PROGRESS
  COMPLETE
}

model CareerAdvisorSession {
  id          String               @id @default(cuid())
  userId      String
  status      AdvisorSessionStatus @default(IN_PROGRESS)
  currentStep Int                  @default(0)
  answers     Json?
  report      Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiPrompt {
  id       String @id @default(cuid())
  key      String @unique
  name     String
  purpose  String
  category String

  tone          String
  requirements  String[]
  exampleOutput String?

  inputVariables String[]
  responseFormat String

  model   String
  enabled Boolean @default(true)

  previousFields Json?
  defaultFields  Json

  updatedBy     String?
  updatedByUser User?    @relation("AiPromptEditor", fields: [updatedBy], references: [id])
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  contextFiles AiPromptContextFile[]

  @@index([category])
}

model AiPromptContextFile {
  id       String   @id @default(cuid())
  promptId String
  prompt   AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  fileName   String
  fileSize   Int
  mimeType   String
  blobUrl    String
  parsedText String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([promptId])
}

// ─── Job Openings ─────────────────────────────────────────────────────────────

model JobOpening {
  id              String            @id @default(cuid())
  title           String
  employer        String
  employerLogoUrl String?
  location        String
  locationType    JobLocationType   @default(ONSITE)
  employmentType  JobEmploymentType

  summary             String
  description         String
  skills              String[]
  autismFriendlyNotes String?

  salary       String?
  hoursPerWeek String?
  startDate    String?
  duration     String?

  applyUrl     String?
  applyEmail   String?
  contactName  String?
  contactEmail String?

  closingDate DateTime
  status      JobStatus @default(DRAFT)

  targetOrgIds String[]
  targetRoles  String[]

  createdById String
  createdBy   User   @relation("JobOpeningCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  attachments JobAttachment[]
  assignments JobAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, closingDate])
  @@index([createdById])
}

model JobAttachment {
  id        String     @id @default(cuid())
  jobId     String
  job       JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  sizeBytes Int
  createdAt DateTime   @default(now())

  @@index([jobId])
}

model JobAssignment {
  id           String  @id @default(cuid())
  jobId        String
  userId       String
  assignedById String
  note         String?

  job        JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User       @relation("JobAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User       @relation("JobAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

// ─── Stripe Payments ──────────────────────────────────────────────────────────

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum FeedbackType {
  BUG
  SUGGESTION
  QUESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String?
  // Nullable: individual subscribers (no org) own the purchase via userId only.
  organisationId          String?
  programId               String
  stripeCheckoutSessionId String         @unique
  stripePaymentIntentId   String?
  amount                  Int
  currency                String         @default("gbp")
  status                  PurchaseStatus @default(PENDING)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisation Organisation?   @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  // Restrict (not Cascade) so deleting a TrainingProgram can't silently wipe
  // its purchase/revenue history. Admins should ARCHIVE programs instead.
  program      TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([programId])
  @@index([userId])
  @@index([status])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([type])
}

model HomePage {
  role      Role     @id
  blocks    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ─── Feedback System ──────────────────────────────────────────────────────────

model FeedbackSubmission {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("FeedbackSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  organisationId String?
  organisation   Organisation? @relation("OrgFeedback", fields: [organisationId], references: [id], onDelete: SetNull)

  type    FeedbackType
  message String       @db.Text

  url        String
  userAgent  String @db.Text
  viewport   String
  clientLogs Json?

  status       FeedbackStatus @default(NEW)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?          @relation("FeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  adminNotes   String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}
